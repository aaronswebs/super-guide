# Azure AI Foundry Configuration
# Replace these placeholders with your actual Azure credentials

# Azure OpenAI/AI Foundry endpoint
# Example: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=<YOUR_AZURE_OPENAI_ENDPOINT>

# Azure OpenAI API Key
AZURE_OPENAI_API_KEY=<YOUR_AZURE_OPENAI_API_KEY>

# GPT-5 Deployment Name (the name you gave when deploying GPT-5 in Azure AI Foundry)
# Example: gpt-5-deployment
AZURE_OPENAI_DEPLOYMENT_NAME=<YOUR_GPT5_DEPLOYMENT_NAME>

# API Version (use the latest supported version)
AZURE_OPENAI_API_VERSION=2025-06-01-preview

# Optional: Azure AI Foundry Project Details
AZURE_SUBSCRIPTION_ID=<YOUR_AZURE_SUBSCRIPTION_ID>
AZURE_RESOURCE_GROUP=<YOUR_RESOURCE_GROUP_NAME>
AZURE_AI_PROJECT_NAME=<YOUR_AI_PROJECT_NAME>

# Agent Configuration
AGENT_NAME=ChatBot Agent
AGENT_INSTRUCTIONS_FILE=agent_instructions.txt

# Context Grounding Configuration (Optional)
# Comma-separated list of context sources to enable
# Available: information_security, risk_management, compliance_regulatory, data_governance, ai_ml_governance
CONTEXT_SOURCES=

# Context Document Paths (Optional)
# Specify file paths or URLs for policy documents
CONTEXT_INFORMATION_SECURITY=
CONTEXT_RISK_MANAGEMENT=
CONTEXT_COMPLIANCE_REGULATORY=
CONTEXT_DATA_GOVERNANCE=
CONTEXT_AI_ML_GOVERNANCE=

# Web Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
