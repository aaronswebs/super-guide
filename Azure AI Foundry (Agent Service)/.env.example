# Azure AI Agent Service Configuration
# Copy this file to .env and replace the placeholder values

# ===========================================================================
# REQUIRED: Azure AI Foundry Project Endpoint
# ===========================================================================
# This is the full project endpoint from the Azure AI Foundry portal.
# Go to your AI Foundry project → Overview → "Project endpoint".
# Example: https://aiproj-grc-agent-grc02.services.ai.azure.com/api/projects/aiproj-grc-agent-grc02
AZURE_AI_PROJECT_ENDPOINT=<YOUR_AZURE_AI_PROJECT_ENDPOINT>

# ===========================================================================
# Model / Deployment
# ===========================================================================
# The name of the model deployment in Azure AI Foundry / Azure OpenAI.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-deployment

# ===========================================================================
# Agent Configuration
# ===========================================================================
AGENT_NAME=ChatBot Agent
AGENT_INSTRUCTIONS_FILE=agent_instructions.txt

# ===========================================================================
# Optional: Azure Project details (used for OTEL service name)
# ===========================================================================
AZURE_AI_PROJECT_NAME=aiproj-grc-agent-grc02

# ===========================================================================
# Context Grounding Configuration (Optional)
# ===========================================================================
# Comma-separated list of context sources to enable
# Available: information_security, risk_management, compliance_regulatory,
#            data_governance, ai_ml_governance
CONTEXT_SOURCES=

# Context Document Paths (Optional)
# Specify file paths or URLs for policy documents
CONTEXT_INFORMATION_SECURITY=
CONTEXT_RISK_MANAGEMENT=
CONTEXT_COMPLIANCE_REGULATORY=
CONTEXT_DATA_GOVERNANCE=
CONTEXT_AI_ML_GOVERNANCE=

# ===========================================================================
# Azure AI Foundry Tracing
# ===========================================================================
# Both env vars must be "true" for full prompt/completion capture:
#   AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED – azure-core SDK tracing
#   OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT – OpenAI instrumentor
# Set to "false" in production if prompt content is sensitive.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# OpenTelemetry service name – appears as cloud_RoleName in App Insights
# and identifies traces in the AI Foundry Tracing blade.
OTEL_SERVICE_NAME=aiproj-grc-agent-grc02

# ===========================================================================
# Web Server Configuration
# ===========================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
